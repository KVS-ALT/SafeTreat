# SQLite database file (relative to prisma/)
DATABASE_URL="file:./dev.db"

# At least 32 characters. Generate one with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string-of-32-plus-chars"

# Gemma: "google" (AI Studio, needs GEMINI_API_KEY), "ollama" (local), or "none" (keyword fallback only)
GEMMA_PROVIDER="google"
GEMINI_API_KEY=""
GEMMA_MODEL="gemma-4-31b-it"
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="gemma3"

# OpenRouteService walking directions (free key at https://openrouteservice.org/dev/#/signup)
ORS_API_KEY=""

# Homeowner ID check (Gemma reads a photo of the ID). "true" lets cards marked SAMPLE/SPECIMEN pass, for demos only.
ID_CHECK_ALLOW_SAMPLES="false"

# Password for the seeded demo accounts "demo" (parent) and "demo-home" (homeowner)
DEMO_PASSWORD="trickortreat"
